import React, { useMemo, useState } from 'react';
import AirflowGraph from './AirflowGraph';
import { 
  Layers, 
  Activity, 
  GitCommit, 
  Clock, 
  Columns, 
  Sparkles, 
  Zap, 
  ArrowRight, 
  ShieldCheck, 
  TrendingDown, 
  Cpu, 
  Database,
  Sliders,
  DollarSign
} from 'lucide-react';
import { 
  AreaChart, 
  Area, 
  XAxis, 
  YAxis, 
  CartesianGrid, 
  Tooltip, 
  ResponsiveContainer, 
  ComposedChart, 
  Bar, 
  Legend, 
  Line, 
  ReferenceLine 
} from 'recharts';

// Import các file kết quả chạy của 5 dự án từ mocks
import projectC2011 from '../mocks/output_C2011-07_main.json';
import projectC2012_04 from '../mocks/output_C2012-04_main.json';
import projectC2012_08 from '../mocks/output_C2012-08_main.json';
import projectC2018 from '../mocks/output_C2018-09_main.json';
import projectC2019 from '../mocks/output_C2019-16_main.json';

const projectsData: Record<string, any> = {
  'C2011-07': projectC2011,
  'C2012-04': projectC2012_04,
  'C2012-08': projectC2012_08,
  'C2018-09': projectC2018,
  'C2019-16': projectC2019,
};

const StatCard = ({ title, value, icon: Icon, color }: any) => (
  <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center transition-all hover:shadow-md">
    <div className={`p-3 rounded-lg mr-4 ${color}`}>
      <Icon size={20} className="text-white" />
    </div>
    <div>
      <p className="text-xs font-semibold text-slate-400 mb-0.5 uppercase tracking-wider">{title}</p>
      <h3 className="text-xl font-black text-slate-800">{value}</h3>
    </div>
  </div>
);

const Workspace = () => {
  const [selectedProject, setSelectedProject] = useState<string>('C2011-07');
  const [activeTab, setActiveTab] = useState<'baseline' | 'pareto' | 'ppo'>('pareto');
  const [selectedParetoOptionIndex, setSelectedParetoOptionIndex] = useState<number>(0);

  // Lấy dữ liệu dự án hiện tại
  const currentProject = useMemo(() => {
    return projectsData[selectedProject];
  }, [selectedProject]);

  const { 
    project_id, 
    cpm_static_makespan, 
    deadline, 
    budget, 
    dependencies, 
    tasks_metadata, 
    monte_carlo, 
    pareto_nsga2, 
    cp_sat_schedule, 
    ppo_schedule,
    project_state_evolution
  } = currentProject;

  const tasks = tasks_metadata;

  // Lấy danh sách các phương án Pareto
  const paretoOptions = useMemo(() => {
    return pareto_nsga2?.options || [];
  }, [pareto_nsga2]);

  // Xác định cấu hình Mode của từng task dựa theo Tab đang chọn
  const { selectedOptionModes, optionLabel, optionMakespan, optionCost, optionRisk } = useMemo(() => {
    let modes: number[] = new Array(tasks.length).fill(0);
    let label = 'Baseline (Normal)';
    let msk = cpm_static_makespan;
    let cost = budget / 1.5; // Ước lượng chi phí chuẩn
    let risk = 0.5;

    if (activeTab === 'baseline') {
      modes = new Array(tasks.length).fill(0);
      label = 'Baseline (Normal)';
      msk = cpm_static_makespan;
      cost = tasks.reduce((sum: number, t: any) => sum + t.normal_cost, 0);
      risk = 0.5;
    } else if (activeTab === 'pareto' && paretoOptions.length > 0) {
      const opt = paretoOptions[selectedParetoOptionIndex] || paretoOptions[0];
      modes = opt.modes;
      label = `Pareto Option ${selectedParetoOptionIndex + 1}`;
      msk = opt.makespan;
      cost = opt.cost;
      risk = opt.risk;
    } else if (activeTab === 'ppo') {
      modes = ppo_schedule?.modes || new Array(tasks.length).fill(0);
      label = 'PPO RL Adaptive Control';
      msk = ppo_schedule?.makespan || cpm_static_makespan;
      cost = ppo_schedule?.tgc || (budget * 0.8);
      risk = 0.15;
    }

    return { selectedOptionModes: modes, optionLabel: label, optionMakespan: msk, optionCost: cost, optionRisk: risk };
  }, [activeTab, selectedParetoOptionIndex, tasks, cpm_static_makespan, budget, paretoOptions, ppo_schedule]);

  // Lấy các chỉ số criticality indices cho Monte Carlo
  const criticalityIndices = useMemo(() => {
    return monte_carlo?.criticality_indices || {};
  }, [monte_carlo]);

  // Ánh xạ tên tiếng Việt và WBS cho các task
  const getTaskNameByWbs = (wbs: string): string => {
    if (wbs.startsWith('1.1')) return `Khảo sát & Chuẩn bị mặt bằng`;
    if (wbs.startsWith('1.2')) return `Thiết kế kỹ thuật & Phê duyệt`;
    if (wbs.startsWith('1.3')) return `Thu mua vật tư & Logistics`;
    if (wbs.startsWith('1.4')) return `Xây dựng kết cấu nền móng`;
    if (wbs.startsWith('1.5')) return `Thi công hệ thống phụ trợ`;
    if (wbs.startsWith('1.6')) return `Lắp đặt cơ điện MEP & Thiết bị`;
    if (wbs.startsWith('1.7')) return `Nghiệm thu kỹ thuật & Đo lường`;
    if (wbs.startsWith('1.8')) return `Hoàn thiện & Nghiệm thu bàn giao`;
    if (wbs.startsWith('1.9')) return `Quản trị dự án & Đánh giá`;
    if (wbs.startsWith('1.10')) return `Nghiệm thu đưa vào vận hành`;
    return `Công tác logistics chi tiết`;
  };

  // Tính toán dữ liệu biểu đồ S-Curve, Gantt & Bell Curve động theo option
  const { combinedData, bellCurveData, ganttData, maxEndHour } = useMemo(() => {
    // 1. Master Analytics (Dòng tiền S-Curve động theo Option và chế độ chạy)
    const monthlyCost: Record<string, number> = {};
    const monthlyTasks: Record<string, Set<string>> = {};
    const startTime = new Date('2026-07-08').getTime();

    tasks.forEach((task: any, idx: number) => {
      const mode = selectedOptionModes[idx] || 0;
      const duration = mode === 1 
        ? Math.round(task.most_probable_duration / 1.5) 
        : mode === 2 
          ? Math.round(task.most_probable_duration / 2.0) 
          : task.most_probable_duration;
      
      const cost = mode === 1 
        ? task.crash_cost 
        : mode === 2 
          ? task.outsource_cost 
          : task.normal_cost;

      // Giả lập thời gian bắt đầu tịnh tiến tăng dần dựa trên chỉ mục task
      const startHour = idx * 12;
      const durationDays = Math.ceil(duration / 8) || 1;
      const startMs = startTime + (startHour / 8) * 24 * 60 * 60 * 1000;
      const dailyCost = cost / durationDays;

      for (let i = 0; i < durationDays; i++) {
        const d = new Date(startMs + i * 24 * 60 * 60 * 1000);
        const monthStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        monthlyCost[monthStr] = (monthlyCost[monthStr] || 0) + dailyCost;

        if (!monthlyTasks[monthStr]) monthlyTasks[monthStr] = new Set();
        monthlyTasks[monthStr].add(task.id);
      }
    });

    const sortedMonths = Object.keys(monthlyCost).sort();
    let cumulative = 0;
    const combined = sortedMonths.map(month => {
      cumulative += monthlyCost[month];
      return {
        month,
        monthlyCost: monthlyCost[month],
        cumulativeCost: cumulative,
        activeCount: monthlyTasks[month]?.size || 0
      };
    });

    // 2. Phân phối xác suất PERT Bell Curve động theo Monte Carlo của dự án
    const mean = monte_carlo?.mean_makespan || cpm_static_makespan;
    const p90Val = monte_carlo?.P90 || (cpm_static_makespan * 1.15);
    // Tính std_dev dựa theo phân vị P90 (P90 = mean + 1.28 * std_dev)
    const stdDev = Math.max(5, (p90Val - mean) / 1.28 || mean * 0.05);

    const bellCurve: any[] = [];
    const steps = 30;
    const startX = mean - stdDev * 3.5;
    const endX = mean + stdDev * 3.5;
    const delta = (endX - startX) / steps;

    for (let x = startX; x <= endX; x += delta) {
      const prob = Math.exp(-0.5 * Math.pow((x - mean) / stdDev, 2));
      bellCurve.push({
        days: Math.round(x),
        probability: prob * 100
      });
    }

    // 3. Mini Gantt Chart (20 công việc đầu tiên hiển thị lịch CP-SAT)
    const cpSatSchedule = cp_sat_schedule?.schedule || {};
    const displayGanttTasks = tasks.slice(0, 20);

    let maxEndHour = 1;
    displayGanttTasks.forEach((t: any) => {
      const sched = cpSatSchedule[t.id];
      if (sched && sched.end > maxEndHour) {
        maxEndHour = sched.end;
      }
    });

    const gantt = displayGanttTasks.map((t: any, idx: number) => {
      const mode = selectedOptionModes[idx] || 0;
      const sched = cpSatSchedule[t.id] || { start: idx * 12, end: idx * 12 + t.most_probable_duration, duration: t.most_probable_duration };
      const isCritical = criticalityIndices[t.id] > 0.75;

      const leftPercent = (sched.start / maxEndHour) * 85; 
      const widthPercent = (sched.duration / maxEndHour) * 85;

      return {
        id: t.id,
        name: t.name || getTaskNameByWbs(t.id.split('_')[1] || ''),
        wbs: t.id.split('_')[1] || t.id,
        isCritical,
        mode,
        startHour: sched.start,
        endHour: sched.end,
        leftPercent,
        widthPercent: Math.max(3, widthPercent)
      };
    });

    return { combinedData: combined, bellCurveData: bellCurve, ganttData: gantt, maxEndHour };
  }, [tasks, selectedOptionModes, monte_carlo, cpm_static_makespan, criticalityIndices, cp_sat_schedule]);

  return (
    <div className="w-full h-[calc(100vh-80px)] overflow-y-auto bg-slate-50 p-6 custom-scrollbar">
      {/* HEADER SECTION */}
      <div className="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div>
          <h1 className="text-xl font-black text-slate-800 tracking-tight flex items-center">
            <Columns className="mr-2 text-blue-600 animate-pulse" size={22} />
            Digital Twin & GNN Pipeline Workspace
          </h1>
          <p className="text-xs text-slate-500 mt-0.5">Khảo sát rủi ro lan truyền đồ thị và tối ưu hóa đa mục tiêu logistics</p>
        </div>

        {/* SELECT PROJECT DROPDOWN */}
        <div className="flex items-center gap-2">
          <label className="text-xs font-bold text-slate-500 uppercase">Dự án:</label>
          <select
            value={selectedProject}
            onChange={(e) => {
              setSelectedProject(e.target.value);
              setSelectedParetoOptionIndex(0);
            }}
            className="bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-800 font-bold py-1.5 px-3 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
          >
            <option value="C2011-07">Nursing Home Nursing (C2011-07)</option>
            <option value="C2012-04">Nursing Home Noordhinder (C2012-04)</option>
            <option value="C2012-08">Hospital Project (C2012-08 - Lớn)</option>
            <option value="C2018-09">Construction Project (C2018-09)</option>
            <option value="C2019-16">Infra Logistics Base (C2019-16)</option>
          </select>
        </div>
        <div className="flex gap-3">
          <button 
            onClick={() => setIsTimeModalOpen(true)}
            className="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-all"
          >
            Manage Calendar
          </button>
          <button 
            onClick={() => setIsResourceModalOpen(true)}
            className="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-all"
          >
            Manage Resources
          </button>
          <button 
            onClick={() => {
              setEditingTask(null);
              setIsTaskModalOpen(true);
            }}
            className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-all"
          >
            + Add Node
          </button>
        </div>
      </div>

      <div className="flex flex-col gap-6">
        {/* ROW 1: STATS */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <StatCard title="Số lượng công việc" value={`${tasks.length} tasks`} icon={Layers} color="bg-blue-500" />
          <StatCard title="Số cạnh phụ thuộc" value={`${dependencies.length} edges`} icon={GitCommit} color="bg-emerald-500" />
          <StatCard title="Makespan CPM gốc" value={`${cpm_static_makespan.toFixed(1)} hrs`} icon={Clock} color="bg-amber-500" />
          <StatCard title="Hạn chót & Ngân sách" value={`${deadline.toFixed(0)}h / $${(budget/1000).toFixed(0)}k`} icon={Activity} color="bg-purple-500" />
        </div>

        {/* ROW 2: GRAPH & OPTION SELECTION */}
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          {/* INTERACTIVE GRAPH */}
          <div className="lg:col-span-3 h-[580px] bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col relative overflow-hidden">
            <div className="bg-slate-50 border-b border-slate-200 px-4 py-3 flex justify-between items-center z-10 shrink-0">
              <div className="flex items-center gap-2">
                <span className="font-bold text-slate-700">Project Network Graph (PyG Graph Representation)</span>
                <span className="text-[10px] bg-blue-100 text-blue-700 font-extrabold px-2 py-0.5 rounded uppercase">
                  {optionLabel}
                </span>
              </div>
              <span className="text-[11px] text-slate-500 bg-slate-200 px-2 py-0.5 rounded flex items-center">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                Digital Twin Live
              </span>
            </div>
            <div className="flex-1 relative min-h-0">
              <div className="absolute inset-0">
                <AirflowGraph 
                  projectId={project_id}
                  tasks={tasks}
                  dependencies={dependencies}
                  selectedOptionModes={selectedOptionModes}
                  criticalityIndices={criticalityIndices}
                />
              </div>
            </div>
          </div>

          {/* PIPELINE CONTROL PANEL (SELECTION OPTIONS) */}
          <div className="lg:col-span-1 h-[580px] bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden">
            <div className="bg-slate-50 border-b border-slate-200 px-4 py-3 flex items-center shrink-0">
              <Sliders className="text-blue-600 mr-2" size={18} />
              <span className="font-bold text-slate-700 text-sm">Pipeline Action Center</span>
            </div>
            
            <div className="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50 custom-scrollbar">
              {/* Selector Tabs */}
              <div className="bg-slate-200/70 p-1 rounded-lg grid grid-cols-3 text-center text-xs font-bold">
                <button 
                  onClick={() => setActiveTab('baseline')}
                  className={`py-1.5 rounded-md transition-colors ${activeTab === 'baseline' ? 'bg-white text-slate-800 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
                >
                  Baseline
                </button>
                <button 
                  onClick={() => setActiveTab('pareto')}
                  className={`py-1.5 rounded-md transition-colors ${activeTab === 'pareto' ? 'bg-white text-slate-800 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
                >
                  Pareto AI
                </button>
                <button 
                  onClick={() => setActiveTab('ppo')}
                  className={`py-1.5 rounded-md transition-colors ${activeTab === 'ppo' ? 'bg-white text-slate-800 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
                >
                  PPO RL
                </button>
              </div>

              {/* Mode Description Card */}
              <div className="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                <div className="flex items-center justify-between">
                  <span className="text-[11px] font-black text-blue-600 uppercase tracking-wider">Cấu hình Đang Chọn</span>
                  <span className="text-[10px] bg-slate-100 px-2 py-0.5 rounded font-mono border text-slate-600">
                    {activeTab === 'baseline' ? 'Pure OR' : activeTab === 'pareto' ? 'NSGA-II' : 'PPO Agent'}
                  </span>
                </div>
                
                <div>
                  <h4 className="font-extrabold text-slate-800 text-sm">{optionLabel}</h4>
                  <p className="text-[11px] text-slate-500 leading-relaxed mt-1">
                    {activeTab === 'baseline' && 'Các công việc vận hành ở chế độ tiêu chuẩn (Standard). Không áp dụng các biện pháp rút ngắn tiến độ.'}
                    {activeTab === 'pareto' && 'Giải pháp Pareto tối ưu hóa đa mục tiêu (Makespan, Chi phí, Rủi ro tích hợp Attention) do thuật toán NSGA-II tìm thấy.'}
                    {activeTab === 'ppo' && 'Lịch trình động do PPO Agent điều khiển qua môi trường giả lập LogisticsGymEnv tự thích ứng với các biến động.'}
                  </p>
                </div>

                <div className="border-t pt-3 space-y-2 text-xs">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Makespan dự báo:</span>
                    <span className="font-bold text-slate-800">{optionMakespan.toFixed(1)}h</span>
                  </div>
                  <div className="flex justify-between flex-wrap">
                    <span className="text-slate-400">Chi phí quy đổi (TGC):</span>
                    <span className="font-bold text-emerald-600">${Number(optionCost).toLocaleString(undefined, {maximumFractionDigits:0})}</span>
                  </div>
                  {activeTab === 'pareto' && (
                    <div className="flex justify-between">
                      <span className="text-slate-400">Chỉ số rủi ro AI:</span>
                      <span className="font-bold text-rose-600">{optionRisk.toFixed(4)}</span>
                    </div>
                  )}
                  {activeTab === 'ppo' && (
                    <div className="flex justify-between">
                      <span className="text-slate-400">Cumulative Reward:</span>
                      <span className="font-bold text-purple-600">{ppo_schedule?.reward?.toFixed(2)}</span>
                    </div>
                  )}
                </div>
              </div>

              {/* Pareto Options Selector */}
              {activeTab === 'pareto' && paretoOptions.length > 0 && (
                <div className="space-y-2">
                  <span className="text-xs font-bold text-slate-500 block uppercase">Danh sách Pareto Options:</span>
                  <div className="space-y-2">
                    {paretoOptions.slice(0, 4).map((opt: any, index: number) => (
                      <button
                        key={index}
                        onClick={() => setSelectedParetoOptionIndex(index)}
                        className={`w-full text-left p-3 rounded-lg border text-xs transition-all flex justify-between items-center ${
                          selectedParetoOptionIndex === index 
                            ? 'bg-blue-50 border-blue-500 shadow-sm' 
                            : 'bg-white hover:bg-slate-50 border-slate-200'
                        }`}
                      >
                        <div>
                          <span className="font-bold text-slate-800 block">Option {index + 1} {index === 0 && '⭐ (Best)'}</span>
                          <span className="text-slate-500 text-[10px]">Cost: ${Number(opt.cost).toLocaleString(undefined, {maximumFractionDigits:0})}</span>
                        </div>
                        <div className="text-right">
                          <span className="font-bold text-blue-600 block">{opt.makespan.toFixed(1)}h</span>
                          <span className="text-slate-400 text-[9px]">Risk: {opt.risk.toFixed(2)}</span>
                        </div>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* State History Evolution Stack */}
              <div className="bg-white p-3 rounded-xl border border-slate-200 shadow-sm space-y-2">
                <span className="text-xs font-bold text-slate-600 block uppercase border-b pb-1">State Evolution History</span>
                <div className="space-y-2 pt-1 text-[11px]">
                  {project_state_evolution?.state_history?.map((st: any) => (
                    <div key={st.state_id} className="flex justify-between items-center border-l-2 border-blue-500 pl-2 py-0.5">
                      <div>
                        <span className="font-bold text-slate-800">State {st.state_id}</span>
                        <span className="text-slate-400 text-[9px] block">
                          {st.action_applied ? `${st.action_applied.action_type} Applied` : 'Initial State'}
                        </span>
                      </div>
                      <div className="text-right">
                        <span className="font-semibold text-slate-700">{st.makespan.toFixed(1)}h</span>
                        <span className="text-slate-400 text-[9px] block">${(st.total_cost/1000).toFixed(0)}k</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* ROW 3: DYNAMIC CHARTS */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* COMBINED CHART */}
          <div className="lg:col-span-2 bg-white p-5 rounded-xl border border-slate-200 shadow-sm h-[400px] flex flex-col">
            <div className="mb-4 shrink-0 flex justify-between items-center">
              <div>
                <h3 className="font-bold text-slate-800">Financial S-Curve & Task Density</h3>
                <p className="text-xs text-slate-500">Chi tiêu lũy kế và mật độ công việc song song được cập nhật tự động</p>
              </div>
              <div className="text-right text-xs bg-emerald-50 px-2 py-1 border border-emerald-100 rounded text-emerald-700 font-bold">
                TGC: ${Number(optionCost).toLocaleString(undefined, {maximumFractionDigits:0})}
              </div>
            </div>
            <div className="h-64">
              <ResponsiveContainer width="100%" height="100%">
                <ComposedChart data={combinedData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
                  <defs>
                    <linearGradient id="colorCumulative" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#3b82f6" stopOpacity={0.4}/>
                      <stop offset="95%" stopColor="#3b82f6" stopOpacity={0}/>
                    </linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#e2e8f0" />
                  <XAxis dataKey="month" tickFormatter={(tick) => `${tick.split('-')[1]}/${tick.split('-')[0].slice(2)}`} minTickGap={20} stroke="#94a3b8" fontSize={11} />
                  <YAxis yAxisId="cost" orientation="left" tickFormatter={(val) => `$${(val/1000).toFixed(0)}k`} stroke="#94a3b8" fontSize={11} />
                  <YAxis yAxisId="cumulative" orientation="right" tickFormatter={(val) => `$${(val/1000).toFixed(0)}k`} stroke="#3b82f6" fontSize={11} />
                  <YAxis yAxisId="density" orientation="right" tickFormatter={(val) => `${val} tasks`} stroke="#10b981" fontSize={11} />
                  <Tooltip formatter={(value: any, name: any) => {
                    if (name === 'monthlyCost') return [`$${Number(value).toLocaleString(undefined, {maximumFractionDigits:0})}`, 'Chi phí tháng'];
                    if (name === 'cumulativeCost') return [`$${Number(value).toLocaleString(undefined, {maximumFractionDigits:0})}`, 'Lũy kế'];
                    return [`${value} tasks`, 'Số công việc song song'];
                  }} labelFormatter={(label) => `Tháng: ${label}`} />
                  <Legend verticalAlign="top" height={36} wrapperStyle={{ fontSize: '11px' }}/>
                  <Bar yAxisId="cost" dataKey="monthlyCost" name="monthlyCost" fill="#cbd5e1" barSize={16} radius={[2, 2, 0, 0]} />
                  <Area yAxisId="cumulative" type="monotone" dataKey="cumulativeCost" name="cumulativeCost" stroke="#3b82f6" strokeWidth={3} fillOpacity={1} fill="url(#colorCumulative)" />
                  <Line yAxisId="density" type="monotone" dataKey="activeCount" name="activeCount" stroke="#10b981" strokeWidth={3} dot={{ r: 3, fill: '#10b981' }} activeDot={{ r: 6 }} />
                </ComposedChart>
              </ResponsiveContainer>
            </div>
          </div>

          {/* PERT BELL CURVE */}
          <div className="lg:col-span-1 bg-white p-5 rounded-xl border border-slate-200 shadow-sm h-[400px] flex flex-col">
            <div className="mb-4 shrink-0">
              <h3 className="font-bold text-slate-800">Monte Carlo Risk Analysis (Level 2 AI)</h3>
              <p className="text-xs text-slate-500">Phân phối xác suất thời gian hoàn thành dự án tích hợp Attention</p>
            </div>
            <div className="h-64">
              <ResponsiveContainer width="100%" height="100%">
                <AreaChart data={bellCurveData} margin={{ top: 30, right: 10, left: -20, bottom: 0 }}>
                  <defs>
                    <linearGradient id="colorBell" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#8b5cf6" stopOpacity={0.5}/>
                      <stop offset="95%" stopColor="#8b5cf6" stopOpacity={0}/>
                    </linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                  <XAxis dataKey="days" stroke="#94a3b8" fontSize={11} tickFormatter={(v) => `${v}h`} />
                  <YAxis stroke="#94a3b8" fontSize={11} tickFormatter={() => ''} />
                  <Tooltip 
                    formatter={(val: any) => [`${Number(val).toFixed(1)}% Xác suất tương đối`, 'Xác suất']}
                    labelFormatter={(label) => `Thời gian hoàn thành: ${label} giờ`}
                  />
                  <ReferenceLine 
                    x={Math.round(monte_carlo?.mean_makespan || cpm_static_makespan)} 
                    stroke="#8b5cf6" 
                    strokeWidth={2}
                    strokeDasharray="3 3" 
                    label={{ position: 'top', value: `Mean: ${Math.round(monte_carlo?.mean_makespan || cpm_static_makespan)}h`, fill: '#6d28d9', fontSize: 11, fontWeight: 'bold' }} 
                  />
                  <ReferenceLine 
                    x={Math.round(monte_carlo?.P90 || (cpm_static_makespan * 1.1))} 
                    stroke="#ef4444" 
                    strokeWidth={2}
                    strokeDasharray="3 3" 
                    label={{ position: 'top', value: `P90: ${Math.round(monte_carlo?.P90 || (cpm_static_makespan * 1.1))}h`, fill: '#b91c1c', fontSize: 11, fontWeight: 'bold' }} 
                  />
                  <Area type="monotone" dataKey="probability" stroke="#8b5cf6" strokeWidth={3} fillOpacity={1} fill="url(#colorBell)" />
                </AreaChart>
              </ResponsiveContainer>
              <div className="absolute bottom-2 left-6 right-6 bg-slate-50 border p-2.5 rounded-lg text-center text-xs flex justify-between text-slate-600">
                <div>
                  <span className="text-[10px] block text-slate-400">Mean Makespan</span>
                  <span className="font-bold text-slate-800">{(monte_carlo?.mean_makespan || cpm_static_makespan).toFixed(1)}h</span>
                </div>
                <div>
                  <span className="text-[10px] block text-slate-400">On-time Prob</span>
                  <span className="font-bold text-emerald-600">{((monte_carlo?.on_time_prob || 0.5) * 100).toFixed(2)}%</span>
                </div>
                <div>
                  <span className="text-[10px] block text-slate-400">P90 Risk</span>
                  <span className="font-bold text-rose-600">{(monte_carlo?.P90 || cpm_static_makespan * 1.15).toFixed(1)}h</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* ROW 4: SIDE BY SIDE COMPARATIVE TABLE */}
        <div className="w-full bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-6">
          <div className="bg-slate-50 border-b border-slate-200 px-5 py-4 flex items-center justify-between">
            <div>
              <h3 className="font-extrabold text-slate-800 text-sm">Pipeline Orchestrator Performance Analysis</h3>
              <p className="text-[11px] text-slate-500 mt-0.5">So sánh định lượng thời lượng (Makespan) và tối ưu hóa chi phí giữa các phương pháp tiếp cận</p>
            </div>
            <div className="flex gap-2">
              <span className="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-extrabold text-[10px] rounded border border-emerald-200 uppercase">
                Active Benchmark
              </span>
            </div>
          </div>
          <div className="p-5 space-y-4">
            {/* Visual Progress Bar Section */}
            <div className="bg-slate-50 p-4 rounded-xl border border-slate-200/60 space-y-3.5">
              <h4 className="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center">
                <Clock size={14} className="mr-1.5 text-blue-600" /> So sánh trực quan Thời lượng (Makespan)
              </h4>
              
              {/* 1. Baseline */}
              <div className="space-y-1">
                <div className="flex justify-between text-xs font-semibold text-slate-600">
                  <span>Baseline (Gốc không tối ưu)</span>
                  <span className="font-bold">{cpm_static_makespan.toFixed(1)} hrs (100%)</span>
                </div>
                <div className="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden relative">
                  <div className="bg-slate-400 h-full w-full rounded-full"></div>
                </div>
              </div>

              {/* 2. CP-SAT */}
              {cp_sat_schedule?.makespan && (
                <div className="space-y-1">
                  <div className="flex justify-between text-xs font-semibold text-slate-700">
                    <span className="flex items-center"><Database size={13} className="mr-1 text-slate-400" /> CP-SAT Solver (OR-Tools)</span>
                    <span className="font-bold text-slate-800">
                      {cp_sat_schedule.makespan} hrs 
                      <span className="text-emerald-600 ml-1.5">(-{((cpm_static_makespan - cp_sat_schedule.makespan) / cpm_static_makespan * 100).toFixed(1)}% thời gian)</span>
                    </span>
                  </div>
                  <div className="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden flex relative">
                    <div 
                      className="bg-blue-500 h-full rounded-l-full" 
                      style={{ width: `${(cp_sat_schedule.makespan / cpm_static_makespan) * 100}%` }}
                    ></div>
                    <div className="flex-1 bg-emerald-100 h-full text-[9px] font-bold text-emerald-800 flex items-center justify-center">
                      Tiết kiệm {(cpm_static_makespan - cp_sat_schedule.makespan).toFixed(0)}h
                    </div>
                  </div>
                </div>
              )}

              {/* 3. PPO Agent */}
              {ppo_schedule?.makespan && (
                <div className="space-y-1">
                  <div className="flex justify-between text-xs font-semibold text-slate-700">
                    <span className="flex items-center"><Cpu size={13} className="mr-1 text-blue-500" /> PPO Agent (Deep Reinforcement Learning)</span>
                    <span className="font-bold text-slate-800">
                      {ppo_schedule.makespan.toFixed(1)} hrs 
                      <span className="text-emerald-600 ml-1.5">(-{((cpm_static_makespan - ppo_schedule.makespan) / cpm_static_makespan * 100).toFixed(1)}% thời gian)</span>
                    </span>
                  </div>
                  <div className="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden flex relative">
                    <div 
                      className="bg-purple-600 h-full rounded-l-full" 
                      style={{ width: `${(ppo_schedule.makespan / cpm_static_makespan) * 100}%` }}
                    ></div>
                    <div className="flex-1 bg-emerald-100 h-full text-[9px] font-bold text-emerald-800 flex items-center justify-center">
                      Tiết kiệm {(cpm_static_makespan - ppo_schedule.makespan).toFixed(0)}h
                    </div>
                  </div>
                </div>
              )}

              {/* 4. Pareto Option Selected */}
              {pareto_nsga2?.selected?.makespan && (
                <div className="space-y-1">
                  <div className="flex justify-between text-xs font-semibold text-slate-700">
                    <span className="flex items-center"><Sparkles size={13} className="mr-1 text-amber-500" /> NSGA-II Pareto Selected Option</span>
                    <span className="font-bold text-slate-800">
                      {pareto_nsga2.selected.makespan.toFixed(1)} hrs 
                      <span className="text-emerald-600 ml-1.5">(-{((cpm_static_makespan - pareto_nsga2.selected.makespan) / cpm_static_makespan * 100).toFixed(1)}% thời gian)</span>
                    </span>
                  </div>
                  <div className="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden flex relative">
                    <div 
                      className="bg-amber-500 h-full rounded-l-full" 
                      style={{ width: `${(pareto_nsga2.selected.makespan / cpm_static_makespan) * 100}%` }}
                    ></div>
                    <div className="flex-1 bg-emerald-100 h-full text-[9px] font-bold text-emerald-800 flex items-center justify-center">
                      Tiết kiệm {(cpm_static_makespan - pareto_nsga2.selected.makespan).toFixed(0)}h
                    </div>
                  </div>
                </div>
              )}
            </div>

            {/* Grid of detail comparisons */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
              {/* CP-SAT Card */}
              <div className="border border-slate-200 rounded-lg p-3 bg-white space-y-2 shadow-sm">
                <div className="flex justify-between items-center border-b pb-1.5">
                  <span className="font-bold text-slate-700 flex items-center"><Database size={13} className="mr-1 text-slate-400" /> CP-SAT (OR)</span>
                  <span className="bg-slate-100 text-slate-600 text-[10px] font-bold px-1.5 py-0.2 rounded border">OPTIMAL</span>
                </div>
                <div className="space-y-1">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Thời lượng:</span>
                    <span className="font-bold text-slate-800">{cp_sat_schedule?.makespan || 'N/A'} hrs</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Chi phí:</span>
                    <span className="font-bold text-slate-800">${Number(paretoOptions[0]?.cost || budget * 0.7).toLocaleString(undefined, {maximumFractionDigits:0})}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Chiến lược:</span>
                    <span className="font-semibold text-blue-600 text-[10px]">Resource Leveling (Tĩnh)</span>
                  </div>
                </div>
              </div>

              {/* PPO Agent Card */}
              <div className="border border-slate-200 rounded-lg p-3 bg-white space-y-2 shadow-sm">
                <div className="flex justify-between items-center border-b pb-1.5">
                  <span className="font-bold text-slate-700 flex items-center"><Cpu size={13} className="mr-1 text-blue-500" /> PPO Agent (AI+RL)</span>
                  <span className="bg-purple-100 text-purple-700 text-[10px] font-bold px-1.5 py-0.2 rounded border border-purple-200">ACTIVE ENV</span>
                </div>
                <div className="space-y-1">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Thời lượng:</span>
                    <span className="font-bold text-slate-800">{ppo_schedule?.makespan ? ppo_schedule.makespan.toFixed(1) : 'N/A'} hrs</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Chi phí quy đổi:</span>
                    <span className="font-bold text-emerald-600">${Number(ppo_schedule?.tgc || 0).toLocaleString(undefined, {maximumFractionDigits:0})}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Chiến lược:</span>
                    <span className="font-semibold text-purple-600 text-[10px]">Dynamic Control (Tự thích ứng)</span>
                  </div>
                </div>
              </div>

              {/* Pareto Selected Card */}
              <div className="border border-slate-200 rounded-lg p-3 bg-white space-y-2 shadow-sm">
                <div className="flex justify-between items-center border-b pb-1.5">
                  <span className="font-bold text-slate-700 flex items-center"><Sparkles size={13} className="mr-1 text-amber-500" /> Pareto Front (NSGA-II)</span>
                  <span className="bg-amber-100 text-amber-700 text-[10px] font-bold px-1.5 py-0.2 rounded border border-amber-200">SELECTED OPTION</span>
                </div>
                <div className="space-y-1">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Thời lượng:</span>
                    <span className="font-bold text-slate-800">{pareto_nsga2?.selected?.makespan?.toFixed(1) || 'N/A'} hrs</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Chi phí:</span>
                    <span className="font-bold text-slate-800">${Number(pareto_nsga2?.selected?.cost || 0).toLocaleString(undefined, {maximumFractionDigits:0})}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Mức độ rủi ro AI:</span>
                    <span className="font-bold text-rose-600">{pareto_nsga2?.selected?.risk?.toFixed(4) || 'N/A'}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* ROW 5: MINI GANTT CHART */}
        <div className="w-full bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden mb-8">
          <div className="bg-slate-50 border-b border-slate-200 px-5 py-4">
            <h3 className="font-bold text-slate-800">Timeline WBS View (Gantt Chart)</h3>
            <p className="text-xs text-slate-500 mt-0.5">Hiển thị lịch trình và các công việc găng cho 20 công việc đầu tiên (Option: {optionLabel})</p>
          </div>
          <div className="p-0">
            {/* Gantt Header */}
            <div className="flex border-b border-slate-200 bg-slate-100/50 py-3 px-4 text-[10px] font-black text-slate-500 uppercase tracking-wider items-center">
              <div className="w-1/3">Tên Công Việc / Phân đoạn WBS</div>
              <div className="w-2/3 border-l border-slate-200 pl-4 relative flex justify-between text-slate-600 font-mono">
                <span className="text-left w-[20%]">0h (Bắt đầu)</span>
                <span className="text-left w-[20%]">{Math.round(maxEndHour * 0.2)}h</span>
                <span className="text-left w-[20%]">{Math.round(maxEndHour * 0.4)}h</span>
                <span className="text-left w-[20%]">{Math.round(maxEndHour * 0.6)}h</span>
                <span className="text-left w-[20%]">{Math.round(maxEndHour * 0.8)}h</span>
                <span className="text-right absolute right-0 pr-4">{maxEndHour}h (Hoàn thành)</span>
              </div>
            </div>
            {/* Gantt Rows */}
            <div className="flex flex-col">
              {ganttData.map((task: any, idx: number) => (
                <div 
                  key={task.id} 
                  className={`flex py-2.5 px-4 border-b border-slate-100 hover:bg-slate-50/70 items-center transition-all ${
                    task.isCritical ? 'border-l-4 border-rose-500 bg-rose-50/10' : 'border-l-4 border-transparent'
                  } ${idx % 2 === 0 ? '' : 'bg-slate-50/10'}`}
                >
                  <div className="w-1/3 flex flex-col justify-center pr-4">
                    <div className="flex items-center gap-1.5 mb-0.5 flex-wrap">
                      <span className="text-[10px] font-bold text-slate-400 bg-slate-100 px-1.5 py-0.2 rounded border border-slate-200/50">
                        WBS {task.wbs}
                      </span>
                      {task.isCritical && (
                        <span className="text-[8px] bg-rose-100 text-rose-600 px-1.5 py-0.2 rounded font-extrabold border border-rose-200 leading-none">GĂNG</span>
                      )}
                      {task.mode === 1 && (
                        <span className="text-[8px] bg-amber-500 text-white px-1.5 py-0.2 rounded font-extrabold leading-none">CRASH</span>
                      )}
                      {task.mode === 2 && (
                        <span className="text-[8px] bg-violet-600 text-white px-1.5 py-0.2 rounded font-extrabold leading-none">OUTSOURCE</span>
                      )}
                    </div>
                    <span className="text-xs font-bold text-slate-700 truncate" title={task.name}>{task.name}</span>
                  </div>
                  <div className="w-2/3 border-l border-slate-200 pl-4 relative h-10 flex items-center">
                    {/* Background Grid Lines */}
                    <div className="absolute inset-0 flex pointer-events-none pl-4">
                      <div className="w-[20%] border-r border-dashed border-slate-100 h-full"></div>
                      <div className="w-[20%] border-r border-dashed border-slate-100 h-full"></div>
                      <div className="w-[20%] border-r border-dashed border-slate-100 h-full"></div>
                      <div className="w-[20%] border-r border-dashed border-slate-100 h-full"></div>
                      <div className="w-[20%] h-full"></div>
                    </div>
                    <div 
                      className={`absolute h-5 rounded shadow-sm hover:scale-[1.02] hover:shadow-md transition-all duration-300 flex items-center justify-center ${
                        task.isCritical 
                          ? 'bg-gradient-to-r from-rose-500 to-rose-600 text-white' 
                          : task.mode === 1 
                            ? 'bg-gradient-to-r from-amber-400 to-amber-500 text-amber-950' 
                            : task.mode === 2 
                              ? 'bg-gradient-to-r from-violet-500 to-violet-600 text-white' 
                              : 'bg-gradient-to-r from-blue-400 to-blue-500 text-white'
                      }`}
                      style={{ 
                        left: `calc(${task.leftPercent}% + 1rem)`, 
                        width: `calc(${task.widthPercent}%)`,
                        minWidth: '24px'
                      }}
                      title={`${task.name}\nCP-SAT Start: ${task.startHour}h | End: ${task.endHour}h\nDuration: ${task.endHour - task.startHour}h (${task.isCritical ? 'Critical' : 'Standard'})`}
                    >
                      <span className="text-[8px] font-black tracking-tight px-1 truncate select-none leading-none">
                        {task.startHour}h-{task.endHour}h ({task.endHour - task.startHour}h)
                      </span>
                    </div>
                  </div>
                </div>
                <div className="flex-1 h-6 bg-slate-100 rounded-md relative">
                  <div 
                    className={`absolute h-full rounded-md shadow-sm transition-all ${
                      task.isCritical ? 'bg-red-400' : 'bg-blue-400'
                    }`}
                    style={{ left: `${task.leftPercent}%`, width: `${task.widthPercent}%` }}
                  ></div>
                </div>
              </div>
            ))}
            {ganttData.length === 0 && (
              <div className="text-center text-slate-400 py-6">No scheduled tasks available</div>
            )}
          </div>
        </div>

      </div>
      
      <TaskFormModal 
        isOpen={isTaskModalOpen}
        onClose={() => setIsTaskModalOpen(false)}
        onSubmit={handleSaveTask}
        initialData={editingTask}
        availableTasks={tasks}
        projectResources={constraint_resources || []}
        constraintLogic={constraint_logic || []}
      />
      
      <ResourceManagerModal
        isOpen={isResourceModalOpen}
        onClose={() => setIsResourceModalOpen(false)}
        projectId={Number(projectId)}
        initialResources={constraint_resources || []}
      />

      <TimeManagerModal
        isOpen={isTimeModalOpen}
        onClose={() => setIsTimeModalOpen(false)}
        projectId={Number(projectId)}
        initialTimeConstraint={projectData.constraint_time}
      />
    </div>
  );
};

export default Workspace;
