            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arr_opt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=21;fontFamily=Times New Roman;" parent="1" source="loss_box" target="opt_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="metrics_box" value="&lt;b&gt;Validation Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;MAE&lt;/b&gt; (Mean Absolute Error)&lt;br&gt;&lt;b&gt;RMSE&lt;/b&gt; (Root Mean Squared Error)&lt;br&gt;&lt;b&gt;R² Score&lt;/b&gt; (Coefficient of Determination)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=21;" parent="1" vertex="1">
