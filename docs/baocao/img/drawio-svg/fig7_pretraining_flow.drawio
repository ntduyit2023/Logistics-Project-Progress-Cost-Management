<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.1.1 Chrome/132.0.6834.210 Electron/34.3.3 Safari/537.36" version="26.1.1">
  <diagram name="Page-1" id="0">
    <mxGraphModel dx="1493" dy="863" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input_data" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Original Task Features&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;\( \mathbf{X}_{task} \in \mathbb{R}^{N \times 39} \)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=15;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="40" y="37.5" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="masking" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Node Masking (25%)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding: 5px;&quot;&gt;Randomly set 25% of task node features to 0.0&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="425" y="30" width="290" height="135" as="geometry" />
        </mxCell>
        <mxCell id="arr_mask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=21;fontFamily=Times New Roman;" parent="1" source="input_data" target="masking" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="masked_data" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Masked Features&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;\( \tilde{\mathbf{X}}_{task} \)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=15;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="880" y="37.5" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arr_m_data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=21;fontFamily=Times New Roman;" parent="1" source="masking" target="masked_data" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hgt_forward" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Heterogeneous Graph Transformer&amp;nbsp;Model (Forward Pass)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;Learns to reconstruct masked features using context from neighboring Resource and Shift nodes via HGTConv.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=15;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="800" y="208.75" width="460" height="217.5" as="geometry" />
        </mxCell>
        <mxCell id="arr_forward" style="rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=21;fontFamily=Times New Roman;" parent="1" source="masked_data" target="hgt_forward" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="recon_data" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Reconstructed Features&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;\( \hat{\mathbf{X}}_{task} \)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=15;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="420" y="257.5" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arr_recon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=21;fontFamily=Times New Roman;" parent="1" source="hgt_forward" target="recon_data" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loss_box" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b style=&quot;color: rgb(204, 0, 0);&quot;&gt;Smooth L1 Loss&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); border: 1px solid rgb(0, 0, 0); padding: 5px; margin-top: 10px;&quot;&gt;$$ \mathcal{L} = \text{Smoothl1}(\hat{\mathbf{X}}_{task}, \mathbf{X}_{task}) $$&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#e06666;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="410" y="480" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="opt_box" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Optimization Setup&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 15px;&quot;&gt;\(\bullet\) &lt;b&gt;Adam&lt;/b&gt; (lr=0.001, wd=1e-4)&lt;br&gt;\(\bullet\) &lt;b&gt;ReduceLROnPlateau&lt;/b&gt; (factor=0.5, patience=10)&lt;br&gt;\(\bullet\) Early Stopping (patience=40)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9daf8;strokeColor=#3b78d8;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=21;" parent="1" vertex="1">
          <mxGeometry x="840" y="460" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="arr_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=classic;fontSize=21;fontFamily=Times New Roman;" parent="1" source="recon_data" target="loss_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_org_loss" style="rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=classic;dashed=1;fontSize=21;fontFamily=Times New Roman;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="input_data" target="loss_box" edge="1">
          <mxGeometry relative="1" as="geometry">
