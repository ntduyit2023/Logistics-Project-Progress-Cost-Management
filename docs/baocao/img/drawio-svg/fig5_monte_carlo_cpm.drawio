<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.1.1 Chrome/132.0.6834.210 Electron/34.3.3 Safari/537.36" version="26.1.1">
  <diagram name="Page-1" id="0">
    <mxGraphModel dx="1576" dy="911" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="box_inputs" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1. HGT AI Predictions &amp;amp; Base Graph&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding-left: 15px;&quot;&gt;&lt;br&gt;\(\bullet\) &lt;b&gt;Duration Factor&lt;/b&gt;: Multiplier for Base Duration&lt;br&gt;\(\bullet\) &lt;b&gt;Expected Delay&lt;/b&gt;: Additive shift bias&lt;br&gt;\(\bullet\) &lt;b&gt;Uncertainty Sigma&lt;/b&gt;: Standard deviation for bounds&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="185" y="10" width="900" height="160" as="geometry" />
        </mxCell>
        <mxCell id="loop_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#000000;strokeWidth=2;dashed=1;fontSize=18;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="50" y="210" width="1170" height="650" as="geometry" />
        </mxCell>
        <mxCell id="loop_title" value="&lt;b&gt;Monte Carlo Simulation Loop (10,000 iterations)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=24;" parent="1" vertex="1">
          <mxGeometry x="375" y="223.75" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="arr_in_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="box_inputs" target="loop_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step1_pert" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;A. Beta-PERT Parameterization&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding: 10px;&quot;&gt;&lt;br&gt;$$ m = \text{Base Duration} \times \text{Factor} + \text{Delay} $$&lt;br&gt;$$ a = \max(0.5, \ m \times (1.0 - 2.0 \times \sigma)) $$&lt;br&gt;$$ b = m \times (1.0 + 3.0 \times \sigma) $$&lt;br&gt;&lt;br&gt;\( duration \sim \text{Betapert}(a, m, b) \)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="75" y="292.5" width="350" height="377.5" as="geometry" />
        </mxCell>
        <mxCell id="step2_fwd" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;B. CPM Forward Pass (Topological)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding: 10px;&quot;&gt;&lt;br&gt;$$ ES_i = \max_{p \in preds(i)} (EF_p + lag_{p,i}) $$&lt;br&gt;$$ EF_i = ES_i + duration_i $$&lt;br&gt;&lt;br&gt;&lt;i&gt;Project Makespan = \(\max(EF)\)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="475" y="312.5" width="320" height="337.5" as="geometry" />
        </mxCell>
        <mxCell id="arr_1_2" style="edgeStyle=none;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="step1_pert" target="step2_fwd" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3_bwd" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;C. CPM Backward Pass (Reversed)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding: 10px;&quot;&gt;&lt;br&gt;$$ LF_i = \min_{s \in succs(i)} (LS_s - lag_{i,s}) $$&lt;br&gt;$$ LS_i = LF_i - duration_i $$&lt;br&gt;$$ Slack_i = LS_i - ES_i $$&lt;br&gt;If \(\text{Abs}(Slack_i) &amp;lt; 10^{-4}\) → &lt;b&gt;Critical&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="850" y="268.125" width="330" height="426.25" as="geometry" />
        </mxCell>
        <mxCell id="arr_2_3" style="edgeStyle=none;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="step2_fwd" target="step3_bwd" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4_record" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;D. Matrix Recordings (per iteration)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;\(\bullet\) &lt;b&gt;Makespan Samples[i]&lt;/b&gt; = Project Makespan&lt;br&gt;\(\bullet\) &lt;b&gt;Critical Counts[t id] += 1&lt;/b&gt; (if Critical)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="275" y="710" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arr_3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontFamily=Times New Roman;" parent="1" source="step3_bwd" target="step4_record" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arr_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=18;fontFamily=Times New Roman;" parent="1" source="step4_record" target="step1_pert" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="out_box" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Outputs passed to CP-SAT Solver&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 100px;&quot;&gt;\(\bullet\) &lt;b&gt;Criticality Index (CI%)&lt;/b&gt; = (Critical Counts / 10000) * 100&lt;br&gt;\(\bullet\) &lt;b&gt;Project Risk Distributions&lt;/b&gt;: P50, P80, P95 Makespan limits&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="235" y="900" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arr_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="loop_box" target="out_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
