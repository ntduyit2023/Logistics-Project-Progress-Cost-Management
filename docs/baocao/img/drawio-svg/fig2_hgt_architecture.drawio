        <mxCell id="concat_all" value="&lt;b&gt;Concat(Task Embed, Global Context)&lt;/b&gt;&lt;br&gt;[N, 384]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;" parent="1" vertex="1">
