<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.1.1 Chrome/132.0.6834.210 Electron/34.3.3 Safari/537.36" version="26.1.1">
  <diagram name="Page-1" id="0">
    <mxGraphModel dx="1418" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="grid_box" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1. Scenario Hyperparameter Grid (linspace)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 20px;&quot;&gt;\( ratios = \text{Np.linspace}(0.0, 1.0, \text{Pareto Count}) \)&lt;br&gt;&lt;br&gt;\(\bullet\) &lt;b&gt;Makespan Weight (\(w_{mk}\))&lt;/b&gt; = 1000 \(\times (1 - ratio)\)&lt;br&gt;\(\bullet\) &lt;b&gt;Cost Weight (\(w_{c}\))&lt;/b&gt; = 10 \(\times ratio\)&lt;br&gt;\(\bullet\) &lt;b&gt;OT Budget Ratio&lt;/b&gt; = \(0.1 + 0.4 \times (1 - ratio)\)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="100" y="40" width="450" height="240" as="geometry" />
        </mxCell>
        <mxCell id="critical_box" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;2. Task Crashing Selection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 20px;&quot;&gt;\(\bullet\) Filter: &lt;b&gt;CI &amp;gt; 0%&lt;/b&gt; from Monte Carlo&lt;br&gt;\(\bullet\) Priority Score: &lt;br&gt;&lt;div style=&quot;text-align:center;&quot;&gt;\( \text{Score} = \text{Uncertainty Sigma} \times \text{Expected Delay} \)&lt;/div&gt;&lt;br&gt;\(\bullet\) Generates Crashing Optional intervals&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="750" y="40" width="450" height="240" as="geometry" />
        </mxCell>
        <mxCell id="solver_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#000000;strokeWidth=2;fontSize=18;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="100" y="320" width="1100" height="620" as="geometry" />
        </mxCell>
        <mxCell id="solver_title" value="&lt;b&gt;3. OR-Tools CP-SAT Model Formulation&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=22;" parent="1" vertex="1">
          <mxGeometry x="400" y="340" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="arr_in1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="grid_box" target="solver_box" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="300" />
              <mxPoint x="325" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arr_in2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="critical_box" target="solver_box" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="975" y="300" />
              <mxPoint x="975" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="vars_box" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Decision Variables&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 15px;&quot;&gt;\(\bullet\) \( S_i, E_i \): Start/End time of Task \(i\)&lt;br&gt;\(\bullet\) \( I_i \): IntervalVar of Task \(i\)&lt;br&gt;\(\bullet\) \( P_{i, mode} \in \{0,1\} \): Presence variable for Crashing Mode&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="140" y="400" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cons_box" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 15px;&quot;&gt;\(\bullet\) &lt;b&gt;Precedence&lt;/b&gt;: \( S_j \ge E_i + lag_{i,j} \)&lt;br&gt;\(\bullet\) &lt;b&gt;Resource Capacity&lt;/b&gt;: \(\text{Addcumulative}(I_i, dem_{i,r}, cap_r)\)&lt;br&gt;\(\bullet\) &lt;b&gt;Alternative Modes&lt;/b&gt;: \(\sum P_{i, mode} = 1\) (Only one mode per task)&lt;br&gt;\(\bullet\) &lt;b&gt;Overtime Budget&lt;/b&gt;: \( \sum \text{Ot Hours} \le \text{Max Ot Budget} \)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="680" y="400" width="500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="obj_box" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;color: rgb(204, 0, 0);&quot;&gt;Multi-Objective Function&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); border: 2px solid rgb(0, 0, 0); padding: 10px; text-align: center;&quot;&gt;$$ \text{Minimize} \left( \mathbf{w_{mk}} \cdot \text{Makespan} + \mathbf{w_c} \cdot \text{Total Cost} + \mathbf{1.0} \cdot \text{Total Risk} \right) $$&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 150px;&quot;&gt;where:&lt;br&gt;- \(\text{Total Risk} = \sum (\text{Penalty} \times \text{Delay Days})\)&lt;br&gt;- \(\text{Makespan} = \max_i(E_i)\)&lt;br&gt;- \(\text{Total Cost} = \sum (\text{Base Costs (38-dim)} + \text{Crash Costs})\)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="250" y="630" width="800" height="280" as="geometry" />
        </mxCell>
        <mxCell id="pareto_box" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;4. Pareto Frontier Extraction (JSON Output)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left; padding-left: 20px;&quot;&gt;&lt;br&gt;Provides diverse trade-off scenarios (N = Pareto Count options)&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9daf8;strokeColor=#3b78d8;strokeWidth=3;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="300" y="990" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="arr_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;endArrow=classic;fontSize=18;fontFamily=Times New Roman;" parent="1" source="solver_box" target="pareto_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
