        <mxCell id="c1_att" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Relation-Specific Attention Score&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); border: 1px solid rgb(0, 0, 0); padding: 5px; margin-top: 10px;&quot;&gt;$$ \text{Attn}(s, d) = \frac{(\mathbf{K}_s \mathbf{W}_{att}^{(\tau)}) \cdot \mathbf{Q}_d^\top}{\sqrt{d/H}} $$&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9daf8;strokeColor=#3b78d8;strokeWidth=2;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=10;fontSize=18;" parent="1" vertex="1">
