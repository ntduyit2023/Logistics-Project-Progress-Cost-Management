        <mxCell id="phase3" value="&lt;b&gt;Phase 1: HGT Task Predictor (Inference)&lt;/b&gt;&lt;br&gt;&lt;span&gt;Global Readout (Mean + Max = 256-dim) + Task (128-dim) → Fusion (384-dim)&lt;br&gt;&lt;b style=&quot;color:#cc0000;&quot;&gt;Outputs:&lt;/b&gt; Duration Factor, Expected Delay, Uncertainty Sigma&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9daf8;strokeColor=#3b78d8;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;" parent="1" vertex="1">
