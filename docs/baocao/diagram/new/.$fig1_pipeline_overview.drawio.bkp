        <mxCell id="hyper_box" value="&lt;b style=&quot;color: rgb(204, 0, 0);&quot;&gt;Hyperparameters&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 10px;&quot;&gt;&lt;br&gt;&lt;b&gt;HGT Model:&lt;/b&gt;&lt;br&gt;- Hidden Dim = 128&lt;br&gt;- Num Heads = 4&lt;br&gt;- Num Layers = 2&lt;br&gt;&lt;br&gt;&lt;b&gt;Monte Carlo:&lt;/b&gt;&lt;br&gt;- MC Iterations = 10,000&lt;br&gt;- Beta-PERT distribution&lt;br&gt;&lt;br&gt;&lt;b&gt;CP-SAT Solver:&lt;/b&gt;&lt;br&gt;- Pareto Count = 5&lt;br&gt;- Time Limit = 15.0s/scen&lt;br&gt;- penalty / bonus / day&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#e06666;strokeWidth=2;align=center;verticalAlign=top;fontFamily=Times New Roman;spacingTop=10;fontSize=18;" parent="1" vertex="1">
